generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                    String      @id @default(uuid())
  email                 String      @unique
  password              String?
  fullName              String      @map("full_name")
  phone                 String?
  role                  UserRole    @default(CLIENT)
  isActive              Boolean     @default(true) @map("is_active")
  createdAt             DateTime    @default(now()) @map("created_at")
  updatedAt             DateTime    @updatedAt @map("updated_at")
  activationToken       String?     @unique @map("activation_token")
  failedLoginAttempts   Int         @default(0) @map("failed_login_attempts")
  isActivated           Boolean     @default(false) @map("is_activated")
  lockedUntil           DateTime?   @map("locked_until")
  tokenExpiry           DateTime?   @map("token_expiry")
  reset_password_token  String?     @unique
  reset_password_expiry DateTime?
  quotationsAsClient    Quotation[] @relation("ClientQuotations")
  quotationsCreated     Quotation[] @relation("AgentQuotations")
  leadsContacted        QuoteLead[] @relation("LeadContactedBy")

  @@map("users")
}

model Quotation {
  id                String          @id @default(uuid())
  clientName        String          @map("client_name")
  clientEmail       String?         @map("client_email")
  clientPhone       String?         @map("client_phone")
  destination       String?
  travelDateFrom    DateTime?       @map("travel_date_from")
  travelDateTo      DateTime?       @map("travel_date_to")
  globalMaxAmount   String          @map("global_max_amount")
  validityTerritory String?         @map("validity_territory")
  consecutiveDays   String?         @map("consecutive_days")
  coverages         Json
  status            QuotationStatus @default(DRAFT)
  notes             String?
  pdfUrl            String?         @map("pdf_url")
  originalPdfUrl    String?         @map("original_pdf_url")
  createdAt         DateTime        @default(now()) @map("created_at")
  updatedAt         DateTime        @updatedAt @map("updated_at")
  clientId          String?         @map("client_id")
  createdById       String          @map("created_by_id")
  client            User?           @relation("ClientQuotations", fields: [clientId], references: [id])
  createdBy         User            @relation("AgentQuotations", fields: [createdById], references: [id])

  @@index([clientId])
  @@index([createdById])
  @@map("quotations")
}

model CompanySettings {
  id              String   @id @default(uuid())
  companyName     String   @map("company_name")
  legalId         String?  @map("legal_id")
  logoUrl         String?  @map("logo_url")
  signatureUrl    String?  @map("signature_url")
  website         String?
  email           String?
  phoneNumbers    Json     @default("[]") @map("phone_numbers")
  socialMedia     Json     @default("{}") @map("social_media")
  businessAddress String?  @map("business_address")
  legalRepName    String?  @map("legal_rep_name")
  legalRepId      String?  @map("legal_rep_id")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")
  faviconUrl      String?  @map("favicon_url")
  pageHeroes      Json     @default("{}") @map("page_heroes")
  legalDocs       Json     @default("[]") @map("legal_docs")

  @@map("company_settings")
}

model AdditionalService {
  id               String   @id @default(uuid())
  name             String
  slug             String   @unique
  category         String
  shortDescription String   @map("short_description")
  fullDescription  String?  @map("full_description")
  basePrice        Float    @map("base_price")
  pricingType      String   @default("per_trip") @map("pricing_type")
  coverageLevels   Json     @default("[]") @map("coverage_levels")
  iconUrl          String?  @map("icon_url")
  imageUrl         String?  @map("image_url")
  isActive         Boolean  @default(true) @map("is_active")
  displayOrder     Int      @default(0) @map("display_order")
  features         Json     @default("[]")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  @@index([category])
  @@index([isActive])
  @@index([displayOrder])
  @@map("additional_services")
}

model QuoteLead {
  id              String          @id @default(uuid())
  destination     String?
  startDate       String?         @map("start_date")
  endDate         String?         @map("end_date")
  totalTravelers  Int             @default(1) @map("total_travelers")
  passengerAges   String?         @map("passenger_ages")
  wantsEmailQuote Boolean         @default(false) @map("wants_email_quote")
  email           String?
  sourceUrl       String?         @map("source_url")
  detectedCountry String?         @map("detected_country")
  routedPhone     String?         @map("routed_phone")
  ip              String?
  userAgent       String?         @map("user_agent")
  status          QuoteLeadStatus @default(NEW)
  notes           String?
  contactedAt     DateTime?       @map("contacted_at")
  contactedById   String?         @map("contacted_by_id")
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")
  contactedBy     User?           @relation("LeadContactedBy", fields: [contactedById], references: [id])

  @@index([status])
  @@index([createdAt])
  @@index([email])
  @@index([contactedById])
  @@map("quote_leads")
}

enum UserRole {
  ADMIN
  AGENT
  CLIENT
}

enum QuotationStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
}

enum QuoteLeadStatus {
  NEW
  CONTACTED
  CONVERTED
  DISCARDED
}
